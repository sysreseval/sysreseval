# The SRE web site: the pages, the sessions, the pool of hosts.  Runs as the unprivileged sre-web
# user; needs neither Docker nor the labs.  Configuration: /etc/sreweb/web.toml.
# Disabled by default: systemctl enable --now sre-web.service
[Unit]
Description=SysResEval web site
Documentation=https://github.com/sysreseval/sysreseval
After=network-online.target

[Service]
Type=simple
User=sre-web
Group=sre-web
ExecStart=/opt/sre/sbin/sre-web
Restart=on-failure
RestartSec=5
# /var/lib/sre-web: the hosts added or removed with `sre-web-tool`
StateDirectory=sre-web
StateDirectoryMode=0750
# /var/log/sre-web: the connection log ([access_log] file of web.toml)
LogsDirectory=sre-web
LogsDirectoryMode=0750
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
