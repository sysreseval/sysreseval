#!/usr/bin/env python3
"""Keep SRE labs on the Debian 12 images.

usage: keep-images-debian12 [-r] <file_or_dir>...

Every lab file (a Python file that defines a subclass of NetScheme0) named on the command line, or
found in a directory named on the command line (its own *.py files, every *.py file below it with -r),
is changed so that its machines stay on the Debian 12 images whatever the default image of SRE:

* sre_docker_image("init") becomes sre_docker_image("init12") and sre_docker_image("base")
  becomes sre_docker_image("base12"): the former names of the Debian 12 images;
* sre_docker_image() without argument, the default image, becomes sre_docker_image("base12");
* the module-level attribute `default_image = sre_docker_image("base12")` (the image NetScheme0 gives
  the machines without an "image") is added after the imports at the top of the file, with
  `from SRE.params import sre_docker_image` when they do not import it.  A lab that already sets
  default_image is left as it is.

The changes are idempotent: a second run changes nothing.  Exit status 1 when a path does not exist or
a file cannot be read, parsed or rewritten (the other files are still processed).
"""
import argparse
import ast
import io
import re
import sys
from pathlib import Path

LAB_BASE_CLASS = "NetScheme0"
IMAGE_FUNCTION = "sre_docker_image"
DEFAULT_IMAGE_ATTR = "default_image"
DEBIAN12_DEFAULT = "base12"
# former name of a Debian 12 image -> its name now
RENAMED_IMAGES = {"base": "base12", "init": "init12"}

IMPORT_LINE = f"from SRE.params import {IMAGE_FUNCTION}"
DEFAULT_IMAGE_LINES = (
    '# machines without an "image" stay on Debian 12 (scripts/keep-images-debian12)',
    f'{DEFAULT_IMAGE_ATTR} = {IMAGE_FUNCTION}("{DEBIAN12_DEFAULT}")',
)

# sre_docker_image("init") / sre_docker_image('base'), also params.sre_docker_image(...)
_RE_RENAMED = re.compile(r"(\b" + IMAGE_FUNCTION + r"\s*\(\s*)(['\"])(" + "|".join(RENAMED_IMAGES) + r")\2(\s*\))")
# sre_docker_image() without argument: the default image
_RE_NO_ARGUMENT = re.compile(r"\b" + IMAGE_FUNCTION + r"\s*\(\s*\)")


class FileError(Exception):
    """A file that cannot be read, parsed or rewritten."""


def _name_of(node: ast.expr) -> str | None:
    if isinstance(node, ast.Name):
        return node.id
    if isinstance(node, ast.Attribute):
        return node.attr
    return None


def is_lab(tree: ast.Module) -> bool:
    """True when the module defines a subclass of NetScheme0 at its top level."""
    return any(isinstance(node, ast.ClassDef) and any(_name_of(b) == LAB_BASE_CLASS for b in node.bases)
               for node in tree.body)


def _assigned_names(node: ast.stmt) -> set[str]:
    """The names a top-level statement binds (assignments and imports)."""
    if isinstance(node, ast.Assign):
        targets = node.targets
    elif isinstance(node, (ast.AnnAssign, ast.AugAssign)):
        targets = [node.target]
    elif isinstance(node, (ast.Import, ast.ImportFrom)):
        return {(a.asname or a.name).split(".")[0] for a in node.names}
    else:
        return set()
    names = set()
    for target in targets:
        for sub in ast.walk(target):
            if isinstance(sub, ast.Name):
                names.add(sub.id)
    return names


def sets_default_image(tree: ast.Module) -> bool:
    return any(DEFAULT_IMAGE_ATTR in _assigned_names(node) for node in tree.body)


def leading_imports(tree: ast.Module) -> list[ast.stmt]:
    """The imports of the block at the top of the module (after its docstring, if any)."""
    body = tree.body
    start = 1 if (body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant)
                  and isinstance(body[0].value.value, str)) else 0
    imports = []
    for node in body[start:]:
        if not isinstance(node, (ast.Import, ast.ImportFrom)):
            break
        imports.append(node)
    return imports


def binds_image_function(imports: list[ast.stmt]) -> bool:
    """True when one of *imports* binds sre_docker_image (by name, or `from SRE.params import *`)."""
    for node in imports:
        if IMAGE_FUNCTION in _assigned_names(node):
            return True
        if isinstance(node, ast.ImportFrom) and node.module == "SRE.params" and any(a.name == "*" for a in node.names):
            return True
    return False


def _split_lines(text: str) -> list[str]:
    """Lines with their endings, split as the parser does (\\n, \\r\\n, \\r only, unlike str.splitlines)."""
    return io.StringIO(text, newline="").readlines()


def _newline_of(lines: list[str]) -> str:
    for line in lines:
        for ending in ("\r\n", "\n", "\r"):
            if line.endswith(ending):
                return ending
    return "\n"


def add_default_image(text: str, tree: ast.Module) -> str:
    """*text* with `default_image = sre_docker_image("base12")` after its leading imports (and the import
    of sre_docker_image when they do not bind it)."""
    lines = _split_lines(text)
    nl = _newline_of(lines)
    imports = leading_imports(tree)
    if imports:
        at = imports[-1].end_lineno
    elif tree.body and isinstance(tree.body[0], ast.Expr) and isinstance(tree.body[0].value, ast.Constant):
        at = tree.body[0].end_lineno  # after the module docstring
    else:
        at = 0
    block = []
    if not binds_image_function(imports):
        block.append(IMPORT_LINE)
    if at:
        block.append("")
    block.extend(DEFAULT_IMAGE_LINES)
    if at < len(lines) and lines[at].strip():
        block.append("")  # keep the next statement apart
    if at and at == len(lines) and not lines[-1].endswith(("\n", "\r")):
        lines[-1] += nl
    lines[at:at] = [line + nl for line in block]
    return "".join(lines)


def convert(text: str, filename: str) -> tuple[str, list[str]] | None:
    """(new text, list of the changes) of a lab file, None when it is not a lab file."""
    try:
        tree = ast.parse(text, filename=filename)
    except SyntaxError as e:
        raise FileError(f"cannot parse: {e}") from e
    if not is_lab(tree):
        return None
    changes = []
    if not sets_default_image(tree):
        text = add_default_image(text, tree)
        changes.append(DEFAULT_IMAGE_ATTR)
    counts = {old: 0 for old in RENAMED_IMAGES}

    def rename(m: re.Match) -> str:
        counts[m.group(3)] += 1
        return f"{m.group(1)}{m.group(2)}{RENAMED_IMAGES[m.group(3)]}{m.group(2)}{m.group(4)}"

    text = _RE_RENAMED.sub(rename, text)
    text, no_argument = _RE_NO_ARGUMENT.subn(f'{IMAGE_FUNCTION}("{DEBIAN12_DEFAULT}")', text)
    for old, new in RENAMED_IMAGES.items():
        if counts[old]:
            changes.append(f"{old}→{new}" + (f" ×{counts[old]}" if counts[old] > 1 else ""))
    if no_argument:
        changes.append(f"{IMAGE_FUNCTION}()→{DEBIAN12_DEFAULT}" + (f" ×{no_argument}" if no_argument > 1 else ""))
    try:
        compile(text, filename, "exec")
    except SyntaxError as e:
        raise FileError(f"the converted file does not compile, left unchanged: {e}") from e
    return text, changes


def process_file(path: Path, explicit: bool) -> str:
    """Convert one file in place: 'modified', 'unchanged' or 'skipped' (not a lab file)."""
    try:
        with open(path, encoding="utf-8", newline="") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        raise FileError(f"cannot read: {e}") from e
    result = convert(text, str(path))
    if result is None:
        if explicit:
            print(f"{path}: skipped, not a lab file (no subclass of {LAB_BASE_CLASS})")
        return "skipped"
    new_text, changes = result
    if new_text == text:
        return "unchanged"
    try:
        with open(path, "w", encoding="utf-8", newline="") as f:
            f.write(new_text)
    except OSError as e:
        raise FileError(f"cannot write: {e}") from e
    print(f"{path}: {', '.join(changes)}")
    return "modified"


def collect_files(arg: str, recursive: bool) -> list[tuple[Path, bool]]:
    """(file, named explicitly) of one command-line argument."""
    path = Path(arg)
    if path.is_dir():
        found = path.rglob("*.py") if recursive else path.glob("*.py")
        return [(f, False) for f in sorted(found) if f.is_file() and "__pycache__" not in f.parts]
    if path.is_file():
        return [(path, True)]
    raise FileError("no such file or directory")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="keep-images-debian12",
        description="Keep the lab files on the Debian 12 images: default_image = sre_docker_image(\"base12\") "
                    "for the machines without an image, sre_docker_image(\"init\") → (\"init12\"), "
                    "(\"base\") → (\"base12\"), sre_docker_image() → (\"base12\").")
    parser.add_argument("-r", dest="recursive", action="store_true",
                        help="look for the lab files in the sub-directories of the directories too")
    parser.add_argument("paths", nargs="+", metavar="file_or_dir", help="lab file, or directory of lab files")
    args = parser.parse_args(argv)

    errors = 0
    seen = set()
    totals = {"modified": 0, "unchanged": 0, "skipped": 0}
    for arg in args.paths:
        try:
            files = collect_files(arg, args.recursive)
        except FileError as e:
            print(f"{arg}: {e}", file=sys.stderr)
            errors += 1
            continue
        for path, explicit in files:
            key = path.resolve()
            if key in seen:
                continue
            seen.add(key)
            try:
                totals[process_file(path, explicit)] += 1
            except FileError as e:
                print(f"{path}: {e}", file=sys.stderr)
                errors += 1
    labs = totals["modified"] + totals["unchanged"]
    print(f"{totals['modified']} file(s) modified out of {labs} lab file(s)"
          + (f", {errors} error(s)" if errors else ""))
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
