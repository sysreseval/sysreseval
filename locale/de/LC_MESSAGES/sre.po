msgid "force language for PDF output (e.g. en, fr)"
msgstr "Sprache der PDF-Ausgabe erzwingen (z. B. en, fr, de)"

msgid "flavor field values, e.g. --flavor a:1 b:foo"
msgstr "Werte der Flavor-Felder, z. B. --flavor a:1 b:foo"

