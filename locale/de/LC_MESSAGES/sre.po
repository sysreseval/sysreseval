msgid "Actions"
msgstr "Aktionen"

msgid "started from SRE-wrapper"
msgstr "von SRE-wrapper gestartet"

msgid "print debug messages on stderr"
msgstr "Debug-Meldungen auf stderr ausgeben"

msgid "lab directory"
msgstr "Laborverzeichnis"

msgid "Remove all files and stop kathara (privileged only)"
msgstr "Alle Dateien entfernen und Kathara stoppen (nur privilegierte Benutzer)"

msgid "Show the version, the state of sre-agent and the running projects (privileged only)"
msgstr "Version, Zustand von sre-agent und laufende Projekte anzeigen (nur privilegierte Benutzer)"

msgid "output as a JSON dict (for scripts)"
msgstr "Ausgabe als JSON-Dict (für Skripte)"

msgid "Ask for the drain of this pool host: no new web project, powered off once it is empty (privileged only)"
msgstr "Das Auslaufen dieses Pool-Rechners anfordern: keine neuen Webprojekte, Ausschalten, sobald er leer ist (nur privilegierte Benutzer)"

msgid "Remove the drain asked on this host by set-drain (privileged only)"
msgstr "Das auf diesem Rechner mit set-drain angeforderte Auslaufen aufheben (nur privilegierte Benutzer)"

msgid "List all available projects"
msgstr "Alle verfügbaren Projekte auflisten"

msgid "Start a lab"
msgstr "Ein Labor starten"

msgid "use this data file (rather than create a new one)"
msgstr "diese Datendatei verwenden (statt eine neue zu erstellen)"

msgid "the lab argument is a path to the lab directory"
msgstr "das Argument lab ist ein Pfad zum Laborverzeichnis"

msgid "lab name or path to the lab directory"
msgstr "Laborname oder Pfad zum Laborverzeichnis"

msgid "Connect to a device (with the predefined command)"
msgstr "Mit einem Gerät verbinden (mit dem vordefinierten Befehl)"

msgid "path to the lab directory"
msgstr "Pfad zum Laborverzeichnis"

msgid "running lab name or path to the lab directory"
msgstr "Name des laufenden Labors oder Pfad zum Laborverzeichnis"

msgid "target device"
msgstr "Zielgerät"

msgid "Apply a state"
msgstr "Einen Zustand anwenden"

msgid "name of the state to apply"
msgstr "Name des anzuwendenden Zustands"

msgid "Evaluate the project"
msgstr "Das Projekt bewerten"

msgid "Evaluate all running projects concurrently"
msgstr "Alle laufenden Projekte gleichzeitig bewerten"

msgid "print grades to stdout (default: true)"
msgstr "Noten auf stdout ausgeben (Standard: true)"

msgid "Stop a running project"
msgstr "Ein laufendes Projekt stoppen"

msgid "Stop every running project the caller may access"
msgstr "Alle laufenden Projekte stoppen, auf die der Aufrufer zugreifen darf"

msgid "running lab name"
msgstr "Name des laufenden Labors"

msgid "Export a running project as a Kathara zip archive (base64 on stdout)"
msgstr ""
"Ein laufendes Projekt als Kathara-Zip-Archiv exportieren (base64 auf stdout)"

msgid "Evaluate all running exam projects concurrently"
msgstr "Alle laufenden Prüfungsprojekte gleichzeitig bewerten"

msgid "Remove exam configuration and wipe all projects"
msgstr "Prüfungskonfiguration entfernen und alle Projekte löschen"

msgid "Pre-start exam: stop foreign projects and start exam labs"
msgstr ""
"Prüfung vorstarten: fremde Projekte stoppen und Prüfungslabore starten"

msgid "Mark the exam as started (sets started_at timestamp)"
msgstr "Die Prüfung als gestartet markieren (setzt den Zeitstempel started_at)"

msgid "Re-grade evaluation archives with a (possibly updated) srelab.py"
msgstr ""
"Bewertungsarchive mit einer (eventuell aktualisierten) srelab.py neu bewerten"

msgid "path to srelab.py or to a directory containing it"
msgstr "Pfad zu srelab.py oder zu einem Verzeichnis, das sie enthält"

msgid "prefix prepended to each output filename"
msgstr "Präfix, das jedem Ausgabedateinamen vorangestellt wird"

msgid "output directory (default: current directory)"
msgstr "Ausgabeverzeichnis (Standard: aktuelles Verzeichnis)"

msgid "archive file(s) to re-evaluate"
msgstr "neu zu bewertende Archivdatei(en)"

msgid "Monitor exam archive directories in real time"
msgstr "Prüfungsarchivverzeichnisse in Echtzeit überwachen"

msgid "directories to scan for .zst archives"
msgstr "nach .zst-Archiven zu durchsuchende Verzeichnisse"

msgid "inactivity alert threshold (default: 90)"
msgstr "Schwelle für den Inaktivitätsalarm (Standard: 90)"

#, python-format
msgid "dashboard refresh interval (default: %(default)s)"
msgstr "Aktualisierungsintervall des Dashboards (Standard: %(default)s)"

msgid ""
"show only hostnames matching this regexp (same as the R key in the dashboard)"
msgstr ""
"nur Rechnernamen anzeigen, die zu diesem regulären Ausdruck passen (wie die "
"Taste R im Dashboard)"

msgid ""
"only consider projects with an archive received after this time (15:01 or "
"2026-09-10 15:01; same as the S key in the dashboard)"
msgstr ""
"nur Projekte berücksichtigen, von denen nach diesem Zeitpunkt ein Archiv "
"empfangen wurde (15:01 oder 2026-09-10 15:01; wie die Taste S im Dashboard)"

msgid ""
"show only the most recently started instance of each lab on each host (same "
"as the L key in the dashboard)"
msgstr ""
"nur die zuletzt gestartete Instanz jedes Labors auf jedem Rechner anzeigen "
"(wie die Taste L im Dashboard)"

msgid ""
"one Sessions row per running instance of a lab instead of one per student"
msgstr ""
"eine Sessions-Zeile pro laufender Instanz eines Labors statt einer pro "
"Studierendem"

msgid ""
"one PDF report and one ODS row per running instance of a lab instead of one "
"per student"
msgstr ""
"ein PDF-Bericht und eine ODS-Zeile pro laufender Instanz eines Labors statt "
"einer pro Studierendem"

msgid ""
"only consider archives created at or after this time (15:01 for today, or "
"2026-09-10 15:01; a bare date means midnight)"
msgstr ""
"nur Archive berücksichtigen, die ab diesem Zeitpunkt erstellt wurden (15:01 "
"für heute oder 2026-09-10 15:01; ein Datum allein bedeutet Mitternacht)"

msgid ""
"only consider archives created at or before this time (15:01 for today, or "
"2026-09-10 15:01; a bare date means midnight)"
msgstr ""
"nur Archive berücksichtigen, die bis zu diesem Zeitpunkt erstellt wurden "
"(15:01 für heute oder 2026-09-10 15:01; ein Datum allein bedeutet "
"Mitternacht)"

msgid "Export evaluation archives to a LibreOffice ODS spreadsheet"
msgstr "Bewertungsarchive in eine LibreOffice-ODS-Tabelle exportieren"

msgid "output .ods file"
msgstr "ODS-Ausgabedatei"

msgid "archive file(s) or director(ies) of .zst archives"
msgstr "Archivdatei(en) oder Verzeichnis(se) mit .zst-Archiven"

msgid "Print the content of evaluation archive files"
msgstr "Den Inhalt von Bewertungsarchivdateien ausgeben"

msgid "show the data field"
msgstr "das Feld data anzeigen"

msgid "show the tests field"
msgstr "das Feld tests anzeigen"

msgid "show the errors field"
msgstr "das Feld errors anzeigen"

msgid "show the answers field"
msgstr "das Feld answers anzeigen"

msgid "show grades (grade_list, total_grade, total_max)"
msgstr "Noten anzeigen (grade_list, total_grade, total_max)"

msgid "output as a single JSON-encoded dict per file"
msgstr "Ausgabe als ein JSON-kodiertes Dict pro Datei"

msgid "archive file(s) to read"
msgstr "zu lesende Archivdatei(en)"

msgid "Create or update the exam configuration"
msgstr "Die Prüfungskonfiguration erstellen oder aktualisieren"

msgid "allowed lab names"
msgstr "erlaubte Labornamen"

msgid "exam opens after this datetime (ISO format, e.g. 2026-06-01T09:00)"
msgstr ""
"die Prüfung öffnet nach diesem Zeitpunkt (ISO-Format, z. B. 2026-06-01T09:00)"

msgid "exam closes before this datetime (ISO format)"
msgstr "die Prüfung schließt vor diesem Zeitpunkt (ISO-Format)"

msgid "maximum exam duration in minutes"
msgstr "maximale Prüfungsdauer in Minuten"

msgid "duration between two evaluations"
msgstr "Zeitraum zwischen zwei Bewertungen"

msgid "Check a lab module for errors"
msgstr "Ein Labormodul auf Fehler prüfen"

msgid "also check this state method of NetScheme"
msgstr "auch diese Zustandsmethode von NetScheme prüfen"

msgid "Generate per-student PDF reports and a summary ODS spreadsheet"
msgstr ""
"PDF-Berichte pro Studierendem und eine zusammenfassende ODS-Tabelle erzeugen"

msgid "output .ods summary file"
msgstr "ODS-Ausgabedatei der Zusammenfassung"

msgid "output directory for PDF reports"
msgstr "Ausgabeverzeichnis für die PDF-Berichte"

msgid "Mark the exam as ended and run a final evaluation of all projects"
msgstr ""
"Die Prüfung als beendet markieren und eine abschließende Bewertung aller "
"Projekte ausführen"

msgid ""
"optional version/seed passed to Data.generate() (privileged only; "
"incompatible with --data)"
msgstr ""
"optionale Version/optionaler Seed für Data.generate() (nur privilegierte "
"Benutzer; nicht mit --data kombinierbar)"

msgid "schema node separation level 0-9 (default: 3)"
msgstr "Abstandsstufe der Knoten im Schema 0-9 (Standard: 3)"

msgid "draw schema edges as curved lines (default: straight)"
msgstr "Kanten des Schemas als Kurven zeichnen (Standard: gerade)"

msgid "draw schema nodes as geometric shapes instead of icons"
msgstr "Knoten des Schemas als geometrische Formen statt als Symbole zeichnen"

msgid "reverse node insertion order in the schema"
msgstr "die Einfügereihenfolge der Knoten im Schema umkehren"

msgid "random seed for node order permutation in the schema"
msgstr "Zufalls-Seed für die Permutation der Knotenreihenfolge im Schema"

msgid ""
"Do pre-start-exam and mark the exam as started (sets started_at timestamp)"
msgstr ""
"pre-start-exam ausführen und die Prüfung als gestartet markieren (setzt den "
"Zeitstempel started_at)"

msgid "Pre-start exam: stop other projects and start exam projects"
msgstr ""
"Prüfung vorstarten: andere Projekte stoppen und Prüfungsprojekte starten"

msgid "record terminal sessions (default: true)"
msgstr "Terminalsitzungen aufzeichnen (Standard: true)"

msgid "Archive session records of running projects into a directory"
msgstr ""
"Die Sitzungsaufzeichnungen laufender Projekte in einem Verzeichnis "
"archivieren"

msgid "destination directory for the record archives"
msgstr "Zielverzeichnis für die Archive der Aufzeichnungen"

msgid ""
"delete previous record archives for the same running project after saving"
msgstr ""
"frühere Aufzeichnungsarchive desselben laufenden Projekts nach dem Sichern "
"löschen"

msgid "warning: cannot read {path}: {e}"
msgstr "Warnung: {path} kann nicht gelesen werden: {e}"

msgid "no archives to process"
msgstr "keine Archive zu verarbeiten"

msgid "written: {path}"
msgstr "geschrieben: {path}"

msgid "saved: {path}"
msgstr "gesichert: {path}"

msgid ""
"error: at least one of --output-file or --pdf-directory must be provided"
msgstr ""
"Fehler: mindestens eine der Optionen --output-file oder --pdf-directory muss "
"angegeben werden"

msgid "error: cannot create output directory {path}: {e}"
msgstr "Fehler: das Ausgabeverzeichnis {path} kann nicht erstellt werden: {e}"

msgid ""
"error: output directory {path} is not writable by user {name} (uid {uid})"
msgstr ""
"Fehler: das Ausgabeverzeichnis {path} ist für den Benutzer {name} (uid {uid}) "
"nicht beschreibbar"

msgid "error: cannot write {path}: {e}"
msgstr "Fehler: {path} kann nicht geschrieben werden: {e}"

msgid "warning: cannot read aux file {path}: {e}"
msgstr "Warnung: die Benutzerdatei {path} kann nicht gelesen werden: {e}"

msgid "warning: login '{login}' not found in aux file"
msgstr "Warnung: Login '{login}' nicht in der Benutzerdatei gefunden"

