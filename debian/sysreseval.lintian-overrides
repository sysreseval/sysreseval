# postinst gives lib/ and the shipped labs to the sre user after every unpack (dpkg unpacks them
# root 0644): the trees are under /usr, owned by root and not writable by the students, who thus
# cannot plant the hard links the tag warns about
sysreseval: recursive-privilege-change "chown -R" [postinst:*]
sysreseval: recursive-privilege-change "chmod -R" [postinst:*]
