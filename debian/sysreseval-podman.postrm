#!/bin/sh
# postrm of sysreseval-podman: what sysreseval-podman-setup wrote into the configuration of
# systemd goes with the package (the unit that gives the host the address of the machines'
# gateway, the drop-ins ordering the services of SysResEval after the user manager of the sre
# user and giving that manager its resource controllers), and so do the lines it added to the
# site file of the AppArmor profile of tcpdump.  Kept: the subordinate ids of the sre
# user, its linger, and /var/lib/sre/podman (the images), like the other data of /var/lib/sre.
set -e

case "$1" in
    remove|purge)
        changed=
        if [ -e /etc/systemd/system/sre-host-address.service ]; then
            if [ -d /run/systemd/system ]; then
                systemctl disable --now sre-host-address.service >/dev/null 2>&1 || true
            fi
            rm -f /etc/systemd/system/sre-host-address.service
            rm -f /etc/systemd/system/multi-user.target.wants/sre-host-address.service
            changed=1
        fi
        for dropin in /etc/systemd/system/*.d/10-sre-podman.conf; do
            [ -e "$dropin" ] || continue
            rm -f "$dropin"
            rmdir --ignore-fail-on-non-empty "$(dirname "$dropin")"
            changed=1
        done
        if [ -n "$changed" ] && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        # the lines the setup script added to the site file of the AppArmor profile of tcpdump
        site=/etc/apparmor.d/local/usr.bin.tcpdump
        if [ -f "$site" ] && grep -q '^# written by sysreseval-podman-setup of SRE: ' "$site"; then
            sed -i -e '/^# written by sysreseval-podman-setup of SRE: /d' \
                -e '/^signal (receive) peer=crun,$/d' -e '/^signal (receive) peer=runc,$/d' "$site"
            if [ -f /etc/apparmor.d/usr.bin.tcpdump ] && [ ! -e /etc/apparmor.d/disable/usr.bin.tcpdump ] \
                    && [ "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = Y ] \
                    && command -v apparmor_parser >/dev/null 2>&1; then
                apparmor_parser -r /etc/apparmor.d/usr.bin.tcpdump >/dev/null 2>&1 || true
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0
